digraph G {
    // The labels use the font Latin Modern Math (from TeX Live), so they look
    // like $q_0$, $A(r)$ and $\varepsilon$ in the lecture notes.
    rankdir=LR;
    fontname="Latin Modern Math";
    fontsize=14;
    node [shape=circle, fixedsize=true, width=0.5,
          fontname="Latin Modern Math", fontsize=14];
    edge [fontname="Latin Modern Math", fontsize=14, arrowsize=0.7];
    1 [shape=none, label="", width=0, height=0];
    1 -> q1;
    q1 [label=<𝑞<SUB>1</SUB>>];
    q2 [label=<𝑞<SUB>2</SUB>>];
    q3 [label=<𝑞<SUB>3</SUB>>];
    q4 [label=<𝑞<SUB>4</SUB>>, shape=doublecircle];
    q2 -> q3 [label="𝜀"];

    subgraph cluster0 {
        label=<𝐴(𝑟<SUB>1</SUB>)>;
        style=rounded;
        q1 -> q2 [style=invis];
    }

    subgraph cluster1 {
        label=<𝐴(𝑟<SUB>2</SUB>)>;
        style=rounded;
        q3 -> q4 [style=invis];
    }
}
