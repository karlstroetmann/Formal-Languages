digraph G {
    // The tokens are set in Latin Modern Mono, like \texttt{2*3+4} in the lecture notes.
    node [shape=circle, fixedsize=true, width=0.4,
          fontname="Latin Modern Mono", fontsize=14];
    edge [arrowsize=0.7];
    1 -> 2;
    1 -> 3;

    3 -> 4;
    3 -> 5;

    1 [label="*"];
    2 [label="2"];
    3 [label="+"];
    4 [label="3"];
    5 [label="4"];
}
