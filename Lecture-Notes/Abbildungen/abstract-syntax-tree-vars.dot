digraph G {
    // The abstract syntax tree of 2*x+y*y-z/(x*x+y*y)-3 that is computed by the parser in
    // Python/Chapter-06/2-EBNF-Parser-AST.ipynb.  The tokens are set in Latin Modern Mono,
    // like the abstract syntax trees of 2*3+4.
    ordering=out;
    node [shape=circle, fixedsize=true, width=0.4,
          fontname="Latin Modern Mono", fontsize=14];
    edge [arrowsize=0.7];
    4 -> 5;
    4 -> 6;
    3 -> 4;
    7 -> 8;
    7 -> 9;
    3 -> 7;
    2 -> 3;
    10 -> 11;
    13 -> 14;
    13 -> 15;
    12 -> 13;
    16 -> 17;
    16 -> 18;
    12 -> 16;
    10 -> 12;
    2 -> 10;
    1 -> 2;
    1 -> 19;

    1 [label="-"];
    2 [label="-"];
    3 [label="+"];
    4 [label="*"];
    5 [label="2"];
    6 [label="x"];
    7 [label="*"];
    8 [label="y"];
    9 [label="y"];
    10 [label="/"];
    11 [label="z"];
    12 [label="+"];
    13 [label="*"];
    14 [label="x"];
    15 [label="x"];
    16 [label="*"];
    17 [label="y"];
    18 [label="y"];
    19 [label="3"];
}
