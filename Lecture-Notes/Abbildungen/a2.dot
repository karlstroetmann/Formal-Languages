digraph G {
    // The states are labelled in Latin Modern Math, like $q_0$ in the lecture
    // notes, the transitions in Latin Modern Mono, like \texttt{a}.
    rankdir=LR;
    node [shape=circle, fixedsize=true, width=0.5,
          fontname="Latin Modern Math", fontsize=14];
    edge [fontname="Latin Modern Mono", fontsize=14, arrowsize=0.7];
    rankdir=TB;
    ranksep=0.2;

    S0 [label=<𝑆<SUB>0</SUB>>];
    S1 [label=<𝑆<SUB>1</SUB>>];
    S2 [label=<𝑆<SUB>2</SUB>>];
    S3 [label=<𝑆<SUB>3</SUB>>];
    S4 [label=<𝑆<SUB>4</SUB>>, shape=doublecircle];
    S5 [label=<𝑆<SUB>5</SUB>>, shape=doublecircle];
    S6 [label=<𝑆<SUB>6</SUB>>, shape=doublecircle];
    S7 [label=<𝑆<SUB>7</SUB>>, shape=doublecircle];

    1 [shape=none, label="", width=0, height=0];
    1 -> S0;

    S0 -> S0 [label="a"];
    S0 -> S1 [label="b"];
    S1 -> S2 [label="a"];
    S1 -> S3 [label="b"];
    S2 -> S4 [label="a"];
    S2 -> S5 [label="b"];
    S3 -> S6 [label="a"];
    S3 -> S7 [label="b"];
    S4 -> S0 [label="a"];
    S4 -> S1 [label="b"];
    S5 -> S2 [label="a"];
    S5 -> S3 [label="b"];
    S6 -> S4 [label="a"];
    S6 -> S5 [label="b"];
    S7 -> S6 [label="a"];
    S7 -> S7 [label="b"];
}
