digraph G {
    // The states of the puzzle of the wolf, the goat, and the cabbage and the
    // crossings between them, as computed in
    // ../../Python/Chapter-04-05/07-Wolf-Goat-Cabbage.ipynb.  A state shows the
    // objects on the left bank, a vertical bar for the river, and the objects on
    // the right bank.  Every crossing can be undone, so every edge has arrow
    // heads at both ends.  The edges point away from the start state, so that
    // dot places the start state at the top and the goal state at the bottom.
    // The solution computed by the function reachable is drawn in red.
    ordering=out;
    nodesep=0.4;
    ranksep=0.5;
    node [shape=box, fontname="Atkinson Hyperlegible Next", fontsize=14];
    edge [dir=both, arrowsize=0.7];

    FWGC [label="farmer wolf goat cabbage |",  color=red, fontcolor=red];
    WC   [label="wolf cabbage | farmer goat",  color=red, fontcolor=red];
    FWC  [label="farmer wolf cabbage | goat",  color=red, fontcolor=red];
    C    [label="cabbage | farmer wolf goat",  color=red, fontcolor=red];
    W    [label="wolf | farmer goat cabbage"];
    FGC  [label="farmer goat cabbage | wolf",  color=red, fontcolor=red];
    FWG  [label="farmer wolf goat | cabbage"];
    G    [label="goat | farmer wolf cabbage",  color=red, fontcolor=red];
    FG   [label="farmer goat | wolf cabbage",  color=red, fontcolor=red];
    E    [label="| farmer wolf goat cabbage",  color=red, fontcolor=red];

    FWGC -> WC  [color=red, penwidth=2];
    WC   -> FWC [color=red, penwidth=2];
    FWC  -> C   [color=red, penwidth=2];
    FWC  -> W;
    C    -> FGC [color=red, penwidth=2];
    W    -> FWG;
    FGC  -> G   [color=red, penwidth=2];
    FWG  -> G;
    G    -> FG  [color=red, penwidth=2];
    FG   -> E   [color=red, penwidth=2];
}
