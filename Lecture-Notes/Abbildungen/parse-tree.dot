graph G {
    // The parse tree of 2*3+4 for the grammar  expr -> expr '+' product | ...
    // Syntactic variables are set in Atkinson Hyperlegible Next Italic, like
    // \textsl{expr} in the lecture notes; the tokens are set in Latin Modern
    // Mono, like \texttt{2*3+4} and the abstract syntax trees.
    ordering=out;
    nodesep=0.3;
    ranksep=0.35;
    node [shape=plaintext, height=0.3, margin=0.02,
          fontname="Atkinson Hyperlegible Next Italic", fontsize=16];
    edge [penwidth=0.8];

    e1 [label="expr"];
    e2 [label="expr"];
    p1 [label="product"];
    p2 [label="product"];
    p3 [label="product"];
    f1 [label="factor"];
    f2 [label="factor"];
    f3 [label="factor"];

    node [fontname="Latin Modern Mono", fontsize=17];
    plus  [label="+"];
    times [label="*"];
    n2    [label="2"];
    n3    [label="3"];
    n4    [label="4"];

    e1 -- e2;  e1 -- plus;  e1 -- p1;
    e2 -- p2;
    p2 -- p3;  p2 -- times;  p2 -- f2;
    p3 -- f1;
    f1 -- n2;
    f2 -- n3;
    p1 -- f3;
    f3 -- n4;
}
