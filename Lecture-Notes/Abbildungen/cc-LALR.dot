digraph G {
    // The LALR-goto-graph of the grammar  s -> c c,  c -> 'x' c | 'y'.
    // Grammar symbols are set in Latin Modern Math and tokens in Latin Modern
    // Mono, like $c \rightarrow \bullet\, \text{\aquoted{x}} c$ in the lecture notes.
    // Gotos on variables are blue, shifts of tokens are dark green.
    rankdir=LR;
    node [shape=box, margin="0.06,0.04", fontname="Latin Modern Math", fontsize=14];
    edge [fontname="Latin Modern Math", fontsize=14, arrowsize=0.7];

    s0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT" COLSPAN="5">𝑠<SUB>0</SUB>:</TD></TR>
        <TR><TD ALIGN="LEFT">𝑠̂</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ 𝑠</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">𝑠</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ 𝑐 𝑐</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT> 𝑐</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT">{<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>}</TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT">{<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>}</TD></TR>
        </TABLE>>];

    s1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT" COLSPAN="5">𝑠<SUB>1</SUB>:</TD></TR>
        <TR><TD ALIGN="LEFT">𝑠̂</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">𝑠 ∙</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD></TR>
        </TABLE>>];

    s2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT" COLSPAN="5">𝑠<SUB>2</SUB>:</TD></TR>
        <TR><TD ALIGN="LEFT">𝑠</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">𝑐 ∙ 𝑐</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT> 𝑐</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD></TR>
        </TABLE>>];

    s3_6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT" COLSPAN="5">𝑠<SUB>3</SUB> + 𝑠<SUB>6</SUB>:</TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT> ∙ 𝑐</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT">{<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>}</TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT> 𝑐</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT">{<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>}</TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">∙ <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT">{<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>}</TD></TR>
        </TABLE>>];

    s4_7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT" COLSPAN="5">𝑠<SUB>4</SUB> + 𝑠<SUB>7</SUB>:</TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT> ∙</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT">{<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>}</TD></TR>
        </TABLE>>];

    s5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT" COLSPAN="5">𝑠<SUB>5</SUB>:</TD></TR>
        <TR><TD ALIGN="LEFT">𝑠</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT">𝑐 𝑐 ∙</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT></TD></TR>
        </TABLE>>];

    s8_9 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT" COLSPAN="5">𝑠<SUB>8</SUB> + 𝑠<SUB>9</SUB>:</TD></TR>
        <TR><TD ALIGN="LEFT">𝑐</TD><TD>&#160;→&#160;</TD><TD ALIGN="LEFT"><FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT> 𝑐 ∙</TD><TD>&#160;:&#160;</TD><TD ALIGN="LEFT">{<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>, <FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">$</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>}</TD></TR>
        </TABLE>>];


    s0 -> s1 [label=<𝑠>, color=blue];
    s0 -> s2 [label=<𝑐>, color=blue];
    s0 -> s3_6 [label=<<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>>, color="#006600"];
    s0 -> s4_7 [label=<<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>>, color="#006600"];
    s2 -> s5 [label=<𝑐>, color=blue];
    s2 -> s3_6 [label=<<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>>, color="#006600"];
    s2 -> s4_7 [label=<<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>>, color="#006600"];
    s3_6 -> s8_9 [label=<𝑐>, color=blue];
    s3_6 -> s3_6 [label=<<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">x</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>>, color="#006600"];
    s3_6 -> s4_7 [label=<<FONT FACE="Atkinson Hyperlegible">’</FONT><FONT FACE="Latin Modern Mono">y</FONT><FONT FACE="Atkinson Hyperlegible">’</FONT>>, color="#006600"];
}
