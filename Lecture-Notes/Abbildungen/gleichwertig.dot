digraph G {
    // The states are labelled in Latin Modern Math, like $q_0$ in the lecture
    // notes, the transitions in Latin Modern Mono, like \texttt{a}.
    // The states of the minimized DFA are equivalence classes of states.
    rankdir=LR;
    node [shape=circle, fixedsize=true, width=0.9,
          fontname="Latin Modern Math", fontsize=14];
    edge [fontname="Latin Modern Mono", fontsize=14, arrowsize=0.7];
    start [shape=none, label="", width=0, height=0];

    start -> 0;
    0  [label=<{𝑞<SUB>0</SUB>}>];
    12 [label=<{𝑞<SUB>1</SUB>, 𝑞<SUB>2</SUB>}>];
    34 [label=<{𝑞<SUB>3</SUB>, 𝑞<SUB>4</SUB>}>, shape=doublecircle];

    0  -> 12 [label="a,b"];
    12 -> 34 [label="a,b"];
    34 -> 12 [label="a,b"];
}
