digraph G {
    // The states are labelled in Latin Modern Math, like $q_0$ in the lecture
    // notes, the transitions in Latin Modern Mono, like \texttt{a}.
    rankdir=LR;
    // Smaller circles and gaps than in the other figures, so that this figure fits
    // the text width at scale 1.0, which keeps its labels at their former 14pt.
    ranksep=0.2;
    nodesep=0.15;
    node [shape=circle, fixedsize=true, width=0.42,
          fontname="Latin Modern Math", fontsize=14];
    edge [fontname="Latin Modern Mono", fontsize=14, arrowsize=0.7];
    start [shape=none, label="", width=0, height=0];

    start -> 0;
    0; 1; 2; 3;
    4 [shape=doublecircle];
    5 [shape=doublecircle];
    6 [shape=doublecircle];
    7 [shape=doublecircle];

    0 -> 0 [label="a"];
    6 -> 6 [label="b"];

    0 -> 1 [label="b"];
    1 -> 2 [label="a"];
    1 -> 3 [label="b"];
    2 -> 4 [label="b"];
    2 -> 7 [label="a"];
    3 -> 5 [label="a"];
    3 -> 6 [label="b"];
    4 -> 2 [label="a"];
    4 -> 3 [label="b"];
    5 -> 4 [label="b"];
    5 -> 7 [label="a"];
    6 -> 5 [label="a"];
    7 -> 1 [label="b"];
    7 -> 0 [label="a"];
}
