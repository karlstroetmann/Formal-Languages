program: stmnt*

stmnt: "if" "(" bool_expr ")" "{" program "}"
     | "while" "(" bool_expr ")" "{" program "}"
     // your code here: for loops
     // your code here: function definitions and return statements
     | assign ";"
     | expr ";"                           -> "expr"

assign: ID ":=" expr

// your code here: the logical operators ||, &&, and !
bool_expr: expr ("==" | "!=" | "<=" | ">=" | "<" | ">") expr

expr: expr ("+" | "-") product
    | product

product: product ("*" | "/" | "%") factor
       | factor

factor: "(" expr ")"
      | INT
      | FLOAT
      | STRING
      | ID
      | ID "(" [expr ("," expr)*] ")" -> "call"
      | "true"
      | "false"

// These literals are left out of the heads of all tuples.
%ignore: "(", ")", "{", "}", ";"

// Lexical definitions
%import common.CNAME -> ID, common.WS, common.CPP_COMMENT, common.C_COMMENT

FLOAT:  /[0-9](_?[0-9])*\.[0-9](_?[0-9])*([eE][+-]?[0-9]+)?/
INT:    /[0-9](_?[0-9])*/
STRING: /"(\\.|[^"\\])*"/

// Ignore whitespace and comments
%ignore WS, C_COMMENT, CPP_COMMENT
