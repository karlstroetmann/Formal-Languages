%nonassoc "<" "=="
%left "+" "-"
%left "*" "/"
%precedence UMINUS
%right "^"

expr : expr "<" expr
     | expr "==" expr
     | expr "+" expr
     | expr "-" expr
     | expr "*" expr
     | expr "/" expr
     | expr "^" expr
     | "-" expr          %prec UMINUS
     | "(" expr ")"      %ignore "(", ")"
     | NUMBER

NUMBER : /0|[1-9][0-9]*/

%import common.WS
%ignore WS
