.class public PrimesFor
.super java/lang/Object

.method public <init>()V
    aload 0
    invokenonvirtual java/lang/Object/<init>()V
    return
.end method

.method public static is_prime(I)I
.limit locals 2
.limit stack  3
        ldc 2
        istore 1
    l4:
        iload  1
        iload 0
        ldc 1
        isub
        if_icmpgt l5
        iload 0
        iload 1
        irem
        ldc 0
        if_icmpeq l1
        bipush 0
        goto l2
    l1:
        bipush 1
    l2:
        ifeq l3
        ldc 0
        ireturn
    l3:
        iinc 1 1
        goto l4
    l5:
        iload 0
        ireturn
.end method


.method public static main([Ljava/lang/String;)V
.limit locals 2
.limit stack  2
        ldc 2
        istore 0
    l4:
        iload  0
        ldc 100
        if_icmpgt l5
        iload 0
        invokestatic PrimesFor/is_prime(I)I
        istore 1
        iload 1
        ldc 0
        if_icmpgt l1
        bipush 0
        goto l2
    l1:
        bipush 1
    l2:
        ifeq l3
        getstatic java/lang/System/out Ljava/io/PrintStream;
        iload 1
        invokevirtual java/io/PrintStream/println(I)V
    l3:
        iinc 0 1
        goto l4
    l5:
        return
.end method


