statement: "{" statements "}"
         | NAME "=" expr ";"
         | "if" "(" bool_expr ")" statement
         | "if" "(" bool_expr ")" statement "else" statement   -> "if-else"
         | "while" "(" bool_expr ")" statement
         | "for" "(" NAME "=" expr ".." expr ")" statement   -> "for"
         | "return" expr ";"
         | expr ";"
