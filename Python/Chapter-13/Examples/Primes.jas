.class public Primes
.super java.lang.Object

.method public <init>() void
    aload 0
    invokenonvirtual java.lang.Object.<init>() void
    return
.end method

.method public static is_prime(int) int
.limit locals 2
.limit stack  2
        ldc 2
        istore 1
    l6:
        iload 1
        iload 0
        if_icmplt l1
        bipush 0
        goto l2
    l1:
        bipush 1
    l2:
        ifeq l7
        iload 0
        iload 1
        irem
        ldc 0
        if_icmpeq l3
        bipush 0
        goto l4
    l3:
        bipush 1
    l4:
        ifeq l5
        ldc 0
        ireturn
    l5:
        iload 1
        ldc 1
        iadd
        istore 1
        goto l6
    l7:
        iload 0
        ireturn
.end method


.method public static main(java.lang.String[]) void
.limit locals 2
.limit stack  2
        ldc 2
        istore 0
    l6:
        iload 0
        ldc 100
        if_icmple l1
        bipush 0
        goto l2
    l1:
        bipush 1
    l2:
        ifeq l7
        iload 0
        invokestatic Primes.is_prime(int) int
        istore 1
        iload 1
        ldc 0
        if_icmpgt l3
        bipush 0
        goto l4
    l3:
        bipush 1
    l4:
        ifeq l5
        getstatic java.lang.System.out java.io.PrintStream
        iload 1
        invokevirtual java.io.PrintStream.println(int) void
    l5:
        iload 0
        ldc 1
        iadd
        istore 0
        goto l6
    l7:
        return
.end method


