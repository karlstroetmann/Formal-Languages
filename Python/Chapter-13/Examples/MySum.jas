.class public MySum
.super java.lang.Object

.method public <init>() void
    aload 0
    invokenonvirtual java.lang.Object.<init>() void
    return
.end method

.method public static sum(int) int
.limit locals 2
.limit stack  2
        ldc 0
        istore 1
    l3:
        iload 0
        ldc 0
        if_icmpne l1
        bipush 0
        goto l2
    l1:
        bipush 1
    l2:
        ifeq l4
        iload 1
        iload 0
        iadd
        istore 1
        iload 0
        ldc 1
        isub
        istore 0
        goto l3
    l4:
        iload 1
        ireturn
.end method


.method public static main(java.lang.String[]) void
.limit locals 1
.limit stack  2
        ldc 6
        ldc 6
        imul
        istore 0
        getstatic java.lang.System.out java.io.PrintStream
        iload 0
        invokestatic MySum.sum(int) int
        invokevirtual java.io.PrintStream.println(int) void
        return
.end method


