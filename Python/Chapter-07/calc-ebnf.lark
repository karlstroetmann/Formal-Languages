stmnt: IDENTIFIER ":=" expr ";"
     | expr ";"

expr: product (("+" | "-") product)*

product: factor (("*" | "/") factor)*

factor: "(" expr ")"    %ignore "(", ")"
      | NUMBER
      | IDENTIFIER

// Lexical definitions
%import common.CNAME -> IDENTIFIER, common.NUMBER, common.WS

// Ignore whitespace
%ignore WS
