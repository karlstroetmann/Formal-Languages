expr: expr "+" product
    | expr "-" product
    | product

product: product "*" unary
       | product "/" unary
       | unary

unary: "-" unary            -> neg
     | factor

factor: base "**" unary
      | base

base: "exp" "(" expr ")"   
    | "ln" "(" expr ")"    
    | "(" expr ")"          
    | NUMBER
    | "x"

%ignore: "(", ")" 

%import common.NUMBER, common.WS
%ignore WS
