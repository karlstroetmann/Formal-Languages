expr: expr "+" product
    | expr "-" product
    | product

product: product "*" unary
       | product "/" unary
       | unary

unary: "-" unary            -> neg
     | factor

factor: base "**" unary
      | base

base: "exp" "(" expr ")"    -> exp
    | "ln" "(" expr ")"     -> ln
    | "(" expr ")"          %ignore "(", ")"
    | NUMBER
    | "x"

%import common.NUMBER, common.WS
%ignore WS
